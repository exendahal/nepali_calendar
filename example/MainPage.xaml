<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NepaliDatePickerDemo.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nep="clr-namespace:NepaliDatePicker.Controls;assembly=NepaliDatePicker.Maui"
    xmlns:vm="clr-namespace:NepaliDatePickerDemo"
    Title="NepaliDatePicker"
    x:DataType="vm:MainViewModel">

    <ContentPage.Resources>

        <!--  Section label: small allcaps metadata above each group  -->
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Sub-label: dim descriptor inside a card  -->
        <Style x:Key="SubLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--  Standard bordered card  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Stroke">
                <Setter.Value>
                    <AppThemeBinding Dark="#3A3A3A" Light="#E5E0EB" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Chip: fills with primary when DataTrigger fires  -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Stroke">
                <Setter.Value>
                    <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor">
                <Setter.Value>
                    <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary filled button  -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#6750A4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Outlined button (secondary / destructive)  -->
        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="0">

            <!--  ── Page header ──────────────────────────────────────────────  -->
            <Label
                Margin="0,4,0,2"
                FontAttributes="Bold"
                FontSize="26"
                Text="Nepali Date Picker" />
            <Label
                Margin="0,0,0,24"
                FontSize="13"
                Opacity="0.5"
                Text="Bikram Sambat · Material Design 3 · .NET MAUI" />

            <!--  ── Today banner ───────────────────────────────────────────────  -->
            <Border
                Margin="0,0,0,24"
                Padding="16,14"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#6750A4" />
                        <GradientStop Offset="1" Color="#7965AF" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="3">
                    <Label
                        FontSize="11"
                        Opacity="0.75"
                        Text="Today"
                        TextColor="White" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding TodayBsDisplay}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="{Binding TodayAdDisplay}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════════════
                CONFIGURATION
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="CONFIGURATION" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="20">

                    <!--  Theme  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SubLabel}" Text="Theme" />
                        <HorizontalStackLayout Spacing="8">

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsLight}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeLightCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Light">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsLight}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsDark}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeDarkCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Dark">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsDark}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsSystem}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeSystemCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="System">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsSystem}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  Language  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SubLabel}" Text="Language" />
                        <HorizontalStackLayout Spacing="8">

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsEnglish}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetEnglishCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="English">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsEnglish}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsNepali}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetNepaliCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Nepali">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsNepali}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  Presentation  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SubLabel}" Text="Presentation" />
                        <HorizontalStackLayout Spacing="8">

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsBottomSheet}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetBottomSheetCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Bottom Sheet">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsBottomSheet}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsDialog}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetDialogCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Dialog">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsDialog}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  Picker style  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SubLabel}" Text="Style" />
                        <HorizontalStackLayout Spacing="8">

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsCalendar}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetCalendarCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Calendar">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsCalendar}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsWheel}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetWheelCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Wheel">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsWheel}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsInput}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetInputCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Input">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsInput}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  Platform theme  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SubLabel}" Text="Platform Theme" />
                        <HorizontalStackLayout Spacing="8">

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsNotNativeTheme}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.DisableNativeThemeCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Material">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsNotNativeTheme}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsNativeTheme}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.EnableNativeThemeCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Native">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsNativeTheme}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                        <Label
                            FontSize="11"
                            Opacity="0.4"
                            Text="Native overrides Presentation and Style to match the platform." />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════════════
                PICKER CONTROL
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="PICKER CONTROL" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">

                    <!--  Default  -->
                    <VerticalStackLayout Margin="0,0,0,14" Spacing="6">
                        <Label Style="{StaticResource SubLabel}" Text="Default" />
                        <nep:NepaliDatePicker
                            DateSelected="OnDateSelected"
                            DisplayMode="{Binding Settings.DisplayMode}"
                            Format="d MMMM yyyy"
                            NativeTheme="{Binding Settings.UseNativeTheme}"
                            PickerStyle="{Binding Settings.PickerStyle}"
                            Placeholder="Select a date…"
                            Presentation="{Binding Settings.Presentation}"
                            SelectedDate="{Binding SelectedDate}"
                            UseNepaliScript="{Binding Settings.IsNepali}" />
                    </VerticalStackLayout>

                    <BoxView
                        Margin="0,0,0,14"
                        HeightRequest="1"
                        Opacity="0.12"
                        Color="#6750A4" />

                    <!--  Teal theme  -->
                    <VerticalStackLayout Margin="0,0,0,14" Spacing="6">
                        <Label Style="{StaticResource SubLabel}" Text="Teal theme" />
                        <nep:NepaliDatePicker
                            BorderColor="#00897B"
                            BorderColorDark="#4DB6AC"
                            CornerRadius="20"
                            DisplayMode="{Binding Settings.DisplayMode}"
                            Format="d MMMM yyyy"
                            InputBackgroundColor="#E0F2F1"
                            InputBackgroundColorDark="#004D40"
                            PickerHeaderColor="#00695C"
                            PickerStyle="{Binding Settings.PickerStyle}"
                            Placeholder="Select a date…"
                            PlaceholderColor="#80CBC4"
                            Presentation="{Binding Settings.Presentation}"
                            PrimaryColor="#00897B"
                            PrimaryColorDark="#80CBC4"
                            SelectedDate="{Binding SelectedDate}"
                            TextColor="#004D40"
                            TextColorDark="#A7FFEB"
                            UseNepaliScript="{Binding Settings.IsNepali}" />
                    </VerticalStackLayout>

                    <BoxView
                        Margin="0,0,0,14"
                        HeightRequest="1"
                        Opacity="0.12"
                        Color="#6750A4" />

                    <!--  Coral theme  -->
                    <VerticalStackLayout Margin="0,0,0,14" Spacing="6">
                        <Label Style="{StaticResource SubLabel}" Text="Coral theme" />
                        <nep:NepaliDatePicker
                            BorderColor="#E53935"
                            CornerRadius="4"
                            DisplayMode="{Binding Settings.DisplayMode}"
                            Format="d MMMM yyyy"
                            InputBackgroundColor="#FFEBEE"
                            InputBackgroundColorDark="#4A0000"
                            PickerHeaderColor="#B71C1C"
                            PickerStyle="{Binding Settings.PickerStyle}"
                            Placeholder="Select a date…"
                            PlaceholderColor="#EF9A9A"
                            Presentation="{Binding Settings.Presentation}"
                            PrimaryColor="#E53935"
                            SelectedDate="{Binding SelectedDate}"
                            TextColor="#B71C1C"
                            TextColorDark="#FF8A80"
                            UseNepaliScript="{Binding Settings.IsNepali}" />
                    </VerticalStackLayout>

                    <BoxView
                        Margin="0,0,0,14"
                        HeightRequest="1"
                        Opacity="0.12"
                        Color="#6750A4" />

                    <!--  Platform native (always on)  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SubLabel}" Text="Platform native (NativeTheme=True)" />
                        <nep:NepaliDatePicker
                            DisplayMode="{Binding Settings.DisplayMode}"
                            Format="d MMMM yyyy"
                            NativeTheme="True"
                            Placeholder="Select a date…"
                            SelectedDate="{Binding SelectedDate}"
                            UseNepaliScript="{Binding Settings.IsNepali}" />
                        <Label
                            FontSize="11"
                            Opacity="0.4"
                            Text="Material on Android · Cupertino on iOS/macOS · Fluent on Windows" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--  Selected date result  -->
            <Border Margin="0,-4,0,24" Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                    <Label Style="{StaticResource SubLabel}" Text="Selected date" />
                    <Label
                        Grid.Row="1"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding SelectedDateDisplay}" />
                    <Label
                        Grid.Row="2"
                        FontSize="13"
                        Opacity="0.55"
                        Text="{Binding AdEquivalentDisplay}" />
                    <Label
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Opacity="0.4"
                        Text="{Binding StatusMessage}"
                        VerticalTextAlignment="Center"
                        WidthRequest="120" />
                </Grid>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════════════
                DATE RANGE
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="DATE RANGE" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, 8, *">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SubLabel}" Text="Start date" />
                            <nep:NepaliDatePicker
                                DisplayMode="{Binding Settings.DisplayMode}"
                                Format="d MMM yyyy"
                                Placeholder="Start…"
                                Presentation="{Binding Settings.Presentation}"
                                SelectedDate="{Binding StartDate}"
                                UseNepaliScript="{Binding Settings.IsNepali}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Style="{StaticResource SubLabel}" Text="End date" />
                            <nep:NepaliDatePicker
                                DisplayMode="{Binding Settings.DisplayMode}"
                                Format="d MMM yyyy"
                                Placeholder="End…"
                                Presentation="{Binding Settings.Presentation}"
                                SelectedDate="{Binding EndDate}"
                                UseNepaliScript="{Binding Settings.IsNepali}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Opacity="0.1"
                        Color="#6750A4" />

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label
                            FontSize="13"
                            Opacity="0.5"
                            Text="Duration"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="17"
                            HorizontalTextAlignment="Center"
                            Text="{Binding RangeDurationDisplay}"
                            VerticalTextAlignment="Center" />
                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="End"
                            Spacing="1">
                            <Label
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                Opacity="0.45"
                                Text="{Binding StartDateDisplay, StringFormat='From  {0}'}" />
                            <Label
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                Opacity="0.45"
                                Text="{Binding EndDateDisplay, StringFormat='To      {0}'}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button
                Margin="0,0,0,28"
                Command="{Binding OpenRangePickerCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Open Range Picker (programmatic)" />

            <!--
                ═══════════════════════════════════════════════════════════════
                PROGRAMMATIC API
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="PROGRAMMATIC API" />

            <Button
                Command="{Binding OpenPickerCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Open Picker — today's date" />

            <Button
                Command="{Binding OpenPickerAtSpecificDateCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Open Picker — 2075 / Ashwin / 15" />

            <Button
                Command="{Binding OpenTealThemePickerCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Open Picker — teal theme" />

            <Button
                Margin="0,0,0,12"
                Command="{Binding OpenNativeThemePickerCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Open Picker — platform native" />

            <Grid Margin="0,0,0,28" ColumnDefinitions="*, 12, *">
                <Button
                    BorderColor="#6750A4"
                    Command="{Binding SetTodayCommand}"
                    Style="{StaticResource OutlinedButton}"
                    Text="Set Today"
                    TextColor="#6750A4" />
                <Button
                    Grid.Column="2"
                    BorderColor="#B3261E"
                    Command="{Binding ClearDateCommand}"
                    Style="{StaticResource OutlinedButton}"
                    Text="Clear"
                    TextColor="#B3261E" />
            </Grid>

            <!--  ── Navigation ──────────────────────────────────────────────  -->
            <Button
                Margin="0,0,0,32"
                Clicked="OnOpenUtilsPageClicked"
                Style="{StaticResource PrimaryButton}"
                Text="Date Utilities — Format · Moment" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
