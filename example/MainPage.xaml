<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NepaliDatePickerDemo.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nep="clr-namespace:NepaliDatePicker.Controls;assembly=NepaliDatePicker.Maui"
    xmlns:vm="clr-namespace:NepaliDatePickerDemo"
    Title="Nepali Date Picker Demo"
    x:DataType="vm:MainViewModel">

    <ContentPage.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  Chip: outlined border that fills when selected via DataTrigger  -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="0">

            <!--  ── Hero ─────────────────────────────────────────────────────  -->
            <Label
                Margin="0,8,0,4"
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="Nepali Date Picker" />
            <Label
                Margin="0,0,0,20"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Opacity="0.6"
                Text="Bikram Sambat · Material Design 3 · .NET MAUI" />

            <!--
                ═══════════════════════════════════════════════════════════════
                SETTINGS CARD
                ════════════════════════════════════════════════════════════════════
            -->
            <Border
                Margin="0,0,0,20"
                Padding="16,14"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Stroke>
                    <AppThemeBinding Dark="#3A3A3A" Light="#E0E0E0" />
                </Border.Stroke>

                <VerticalStackLayout Spacing="16">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="⚙  Preview Settings" />

                    <!--  THEME row  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Margin="0"
                            Style="{StaticResource SectionLabel}"
                            Text="THEME" />
                        <HorizontalStackLayout Spacing="8">

                            <!--  Light  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsLight}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeLightCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Light">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsLight}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!--  Dark  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsDark}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeDarkCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Dark">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsDark}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!--  System  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsSystem}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetThemeSystemCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="System">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsSystem}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  LANGUAGE row  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Margin="0"
                            Style="{StaticResource SectionLabel}"
                            Text="LANGUAGE" />
                        <HorizontalStackLayout Spacing="8">

                            <!--  English (Both)  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsEnglish}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetEnglishCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="English">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsEnglish}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!--  Nepali (BsOnly)  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsNepali}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetNepaliCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Nepali">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsNepali}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!--  PICKER LAYOUT row  -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Margin="0"
                            Style="{StaticResource SectionLabel}"
                            Text="PICKER LAYOUT" />
                        <HorizontalStackLayout Spacing="8">

                            <!--  Bottom Sheet  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsBottomSheet}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetBottomSheetCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Bottom Sheet">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsBottomSheet}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!--  Middle (Dialog)  -->
                            <Border Style="{StaticResource ChipBorder}">
                                <Border.Stroke>
                                    <SolidColorBrush Color="#6750A4" />
                                </Border.Stroke>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Settings.IsDialog}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#6750A4" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Settings.SetDialogCommand}" />
                                </Border.GestureRecognizers>
                                <Label Style="{StaticResource ChipLabel}" Text="Middle (Dialog)">
                                    <Label.TextColor>
                                        <AppThemeBinding Dark="#D0BCFF" Light="#6750A4" />
                                    </Label.TextColor>
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding Settings.IsDialog}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--  ── Today info card ──────────────────────────────────────────  -->
            <Border
                Margin="0,0,0,20"
                Padding="16,14"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#6750A4" />
                        <GradientStop Offset="1" Color="#9C27B0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="12"
                        Opacity="0.75"
                        Text="Today"
                        TextColor="White" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding TodayBsDisplay}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.85"
                        Text="{Binding TodayAdDisplay}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!--
                ══════════════════════════════════════════════════════════════
                SECTION 1 — Default picker
                ══════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="DEFAULT" />

            <nep:NepaliDatePicker
                Margin="0,0,0,16"
                DateSelected="OnDateSelected"
                DisplayMode="{Binding Settings.DisplayMode}"
                Format="d MMMM yyyy"
                Placeholder="Pick a date…"
                Presentation="{Binding Settings.Presentation}"
                SelectedDate="{Binding SelectedDate}"
                UseNepaliScript="{Binding Settings.IsNepali}" />

            <!--
                ══════════════════════════════════════════════════════════════
                SECTION 2 — Custom teal theme
                ══════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="CUSTOM STYLE — teal theme" />

            <nep:NepaliDatePicker
                Margin="0,0,0,16"
                BorderColor="#00897B"
                BorderColorDark="#4DB6AC"
                CornerRadius="20"
                DisplayMode="{Binding Settings.DisplayMode}"
                Format="d MMMM yyyy"
                InputBackgroundColor="#E0F2F1"
                InputBackgroundColorDark="#004D40"
                PickerHeaderColor="#00695C"
                Placeholder="Custom teal picker…"
                PlaceholderColor="#80CBC4"
                Presentation="{Binding Settings.Presentation}"
                PrimaryColor="#00897B"
                PrimaryColorDark="#80CBC4"
                SelectedDate="{Binding SelectedDate}"
                TextColor="#004D40"
                TextColorDark="#A7FFEB"
                UseNepaliScript="{Binding Settings.IsNepali}" />

            <!--
                ══════════════════════════════════════════════════════════════
                SECTION 3 — Custom coral theme
                ══════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="CUSTOM STYLE — coral theme" />

            <nep:NepaliDatePicker
                Margin="0,0,0,24"
                BorderColor="#E53935"
                CornerRadius="4"
                DisplayMode="{Binding Settings.DisplayMode}"
                Format="d MMMM yyyy"
                InputBackgroundColor="#FFEBEE"
                InputBackgroundColorDark="#4A0000"
                PickerHeaderColor="#B71C1C"
                Placeholder="Custom coral picker…"
                PlaceholderColor="#EF9A9A"
                Presentation="{Binding Settings.Presentation}"
                PrimaryColor="#E53935"
                SelectedDate="{Binding SelectedDate}"
                TextColor="#B71C1C"
                TextColorDark="#FF8A80"
                UseNepaliScript="{Binding Settings.IsNepali}" />

            <!--
                ══════════════════════════════════════════════════════════════
                SECTION 4 — Date range selection
                ══════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="DATE RANGE SELECTION" />

            <Grid Margin="0,0,0,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="11"
                        Opacity="0.55"
                        Text="Start date" />
                    <nep:NepaliDatePicker
                        DisplayMode="{Binding Settings.DisplayMode}"
                        Format="d MMM yyyy"
                        Placeholder="Start…"
                        Presentation="{Binding Settings.Presentation}"
                        SelectedDate="{Binding StartDate}"
                        UseNepaliScript="{Binding Settings.IsNepali}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontSize="11"
                        Opacity="0.55"
                        Text="End date" />
                    <nep:NepaliDatePicker
                        DisplayMode="{Binding Settings.DisplayMode}"
                        Format="d MMM yyyy"
                        Placeholder="End…"
                        Presentation="{Binding Settings.Presentation}"
                        SelectedDate="{Binding EndDate}"
                        UseNepaliScript="{Binding Settings.IsNepali}" />
                </VerticalStackLayout>
            </Grid>

            <Border
                Margin="0,0,0,8"
                Padding="16,14"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#0097A7" />
                        <GradientStop Offset="1" Color="#00695C" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="12"
                        Opacity="0.75"
                        Text="Selected Range"
                        TextColor="White" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding RangeDurationDisplay}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.85"
                        Text="{Binding StartDateDisplay, StringFormat='From: {0}'}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.85"
                        Text="{Binding EndDateDisplay, StringFormat='To:     {0}'}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Button
                Margin="0,0,0,24"
                BackgroundColor="#0097A7"
                Command="{Binding OpenRangePickerCommand}"
                CornerRadius="12"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Open Range Picker (programmatic)"
                TextColor="White" />

            <!--  ── Selected date card ────────────────────────────────────────  -->
            <Border
                Margin="0,0,0,12"
                Padding="16,14"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF4081" />
                        <GradientStop Offset="1" Color="#7C4DFF" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontSize="12"
                        Opacity="0.75"
                        Text="Selected Date"
                        TextColor="White" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding SelectedDateDisplay}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Opacity="0.85"
                        Text="{Binding AdEquivalentDisplay}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label
                Margin="0,8,0,20"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Opacity="0.65"
                Text="{Binding StatusMessage}" />

            <!--
                ══════════════════════════════════════════════════════════════
                PROGRAMMATIC API
                ══════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="PROGRAMMATIC API" />
            <Label
                Margin="0,0,0,12"
                FontSize="12"
                Opacity="0.55"
                Text="All buttons use the Language + Layout settings above." />

            <Button
                Margin="0,0,0,8"
                BackgroundColor="#007AFF"
                Command="{Binding OpenPickerCommand}"
                CornerRadius="12"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="Open Picker (today's date)"
                TextColor="White" />

            <Button
                Margin="0,0,0,8"
                BackgroundColor="#5856D6"
                Command="{Binding OpenPickerAtSpecificDateCommand}"
                CornerRadius="12"
                HeightRequest="50"
                Text="Open Picker at 2075 / Ashwin / 15"
                TextColor="White" />

            <Button
                Margin="0,0,0,8"
                BackgroundColor="#00897B"
                Command="{Binding OpenTealThemePickerCommand}"
                CornerRadius="12"
                HeightRequest="50"
                Text="Open with Teal Theme"
                TextColor="White" />

            <Grid Margin="0,0,0,32" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    BackgroundColor="#34C759"
                    Command="{Binding SetTodayCommand}"
                    CornerRadius="12"
                    HeightRequest="48"
                    Text="Set Today"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    BackgroundColor="#FF3B30"
                    Command="{Binding ClearDateCommand}"
                    CornerRadius="12"
                    HeightRequest="48"
                    Text="Clear"
                    TextColor="White" />
            </Grid>

            <!--  ── Feature list ─────────────────────────────────────────────  -->
            <Label
                Margin="0,0,0,10"
                FontAttributes="Bold"
                FontSize="17"
                Text="Features" />
            <VerticalStackLayout Margin="0,0,0,40" Spacing="8">
                <Label FontSize="14" Text="✅  Material Design 3 calendar grid UI" />
                <Label FontSize="14" Text="✅  Bottom sheet with slide animation" />
                <Label FontSize="14" Text="✅  Dialog presentation (centered + fade/scale animation)" />
                <Label FontSize="14" Text="✅  Auto day clamping (BS months vary 29–32 days)" />
                <Label FontSize="14" Text="✅  Accurate BS ↔ AD conversion (validated to Jestha 23, 2083)" />
                <Label FontSize="14" Text="✅  DisplayMode: BsOnly / Both (with BS/AD chip toggle)" />
                <Label FontSize="14" Text="✅  Live settings: Theme, Language, Picker Layout" />
                <Label FontSize="14" Text="✅  User-defined colors, corner radius, font family" />
                <Label FontSize="14" Text="✅  Light and dark theme aware" />
                <Label FontSize="14" Text="✅  NepaliDatePicker drop-in control" />
                <Label FontSize="14" Text="✅  INepaliDatePickerService for DI / MVVM" />
                <Label FontSize="14" Text="✅  Date range selection (two-picker pattern)" />
                <Label FontSize="14" Text="✅  BS year range 1970 – 2100" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
