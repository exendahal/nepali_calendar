<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NepaliDatePickerDemo.Avalonia.Browser</RootNamespace>
    <AssemblyName>NepaliDatePickerDemo.Avalonia.Browser</AssemblyName>
  </PropertyGroup>

  <!-- Avalonia.Browser is only stable from Avalonia 12.x onward.
       Upgrade all Avalonia packages to 12.x+ before enabling this project. -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NepaliDatePickerDemo.Avalonia.csproj" />
  </ItemGroup>

</Project>
