<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <RootNamespace>NepaliDatePickerDemo.Avalonia.iOS</RootNamespace>
    <AssemblyName>NepaliDatePickerDemo.Avalonia.iOS</AssemblyName>
    <ApplicationTitle>Nepali Date Picker</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NepaliDatePickerDemo.Avalonia.csproj" />
  </ItemGroup>

</Project>
