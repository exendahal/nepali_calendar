<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NepaliDatePickerDemo.UtilsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nep="clr-namespace:NepaliDatePicker.Controls;assembly=NepaliDatePicker.Maui"
    xmlns:vm="clr-namespace:NepaliDatePickerDemo"
    Title="Date Utilities"
    x:DataType="vm:UtilsViewModel">

    <ContentPage.Resources>

        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SubLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Stroke">
                <Setter.Value>
                    <AppThemeBinding Dark="#3A3A3A" Light="#E5E0EB" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Result row inside a card  -->
        <Style x:Key="ResultRow" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Stroke">
                <Setter.Value>
                    <AppThemeBinding Dark="#2E2E2E" Light="#EEEBF3" />
                </Setter.Value>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="0">

            <!--  ── Page header ──────────────────────────────────────────────  -->
            <Label
                Margin="0,4,0,2"
                FontAttributes="Bold"
                FontSize="26"
                Text="Date Utilities" />
            <Label
                Margin="0,0,0,28"
                FontSize="13"
                Opacity="0.5"
                Text="Format · Moment · Conversion" />

            <!--
                ═══════════════════════════════════════════════════════════════
                DATE FORMATTER
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="DATE FORMATTER" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="13"
                        Opacity="0.55"
                        Text="Pick a BS date to see it rendered in multiple formats." />

                    <nep:NepaliDatePicker
                        DisplayMode="BsOnly"
                        Format="d MMMM yyyy"
                        Placeholder="Select a date…"
                        SelectedDate="{Binding PickedDate}" />

                    <!--  English format results  -->
                    <Border Style="{StaticResource ResultRow}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="d MMMM yyyy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_dMMMMyyy}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ResultRow}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="dd/MM/yyyy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_ddMMyyy}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ResultRow}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="EEEE, d MMMM yyyy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_EEEEdMMMMyyy}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ResultRow}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="EEE d MMM, yy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_EEEdMMMyyy}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" Opacity="0.1" Color="#6750A4" Margin="0,4,0,4" />

                    <!--  Devanagari results  -->
                    <Label Style="{StaticResource SubLabel}" Text="Devanagari script (nepali: true)" />

                    <Border Style="{StaticResource ResultRow}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="d MMMM yyyy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_dMMMMyyyNp}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ResultRow}" Margin="0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Style="{StaticResource SubLabel}" Text="EEEE, d MMMM yyyy" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" FontAttributes="Bold" FontSize="15" Text="{Binding Fmt_EEEEdMMMMyyyNp}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!--
                ═══════════════════════════════════════════════════════════════
                MOMENT — RELATIVE TIME
                ═══════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="MOMENT — RELATIVE TIME" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="13"
                        Opacity="0.55"
                        Text="How long ago (or from now) is the picked date, relative to a reference?" />

                    <Grid ColumnDefinitions="*, 8, *">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SubLabel}" Text="Date" />
                            <nep:NepaliDatePicker
                                DisplayMode="BsOnly"
                                Format="d MMM yyyy"
                                Placeholder="Select…"
                                SelectedDate="{Binding PickedDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6">
                            <Label Style="{StaticResource SubLabel}" Text="Reference (blank = today)" />
                            <nep:NepaliDatePicker
                                DisplayMode="BsOnly"
                                Format="d MMM yyyy"
                                Placeholder="Today"
                                SelectedDate="{Binding ReferenceDate}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Opacity="0.1" Color="#6750A4" Margin="0,2,0,2" />

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="16" RowSpacing="10">
                        <Label
                            FontSize="11"
                            Opacity="0.45"
                            Text="English"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding MomentResult}"
                            VerticalTextAlignment="Center" />

                        <Label
                            Grid.Row="1"
                            FontSize="11"
                            Opacity="0.45"
                            Text="नेपाली"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding MomentResultNepali}"
                            VerticalTextAlignment="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
