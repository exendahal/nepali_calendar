<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NepaliDatePickerDemo.UtilsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nep="clr-namespace:NepaliDatePicker.Controls;assembly=NepaliDatePicker.Maui"
    xmlns:vm="clr-namespace:NepaliDatePickerDemo"
    Title="Date Utils"
    x:DataType="vm:UtilsViewModel">

    <ContentPage.Resources>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ResultLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="ResultValue" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="0">

            <!--  ── Hero ──────────────────────────────────────────────────────  -->
            <Label
                Margin="0,8,0,2"
                FontAttributes="Bold"
                FontSize="24"
                HorizontalTextAlignment="Center"
                Text="Nepali Date Utils" />
            <Label
                Margin="0,0,0,24"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Opacity="0.55"
                Text="Format · Moment · Amount" />

            <!--
                ════════════════════════════════════════════════════════════════
                SECTION 1 — DATE FORMATTER
                ════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="DATE FORMATTER" />

            <Border
                Margin="0,0,0,20"
                Padding="16,14"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Stroke>
                    <AppThemeBinding Dark="#3A3A3A" Light="#E0E0E0" />
                </Border.Stroke>
                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="13"
                        Opacity="0.6"
                        Text="Pick a BS date to see it rendered in multiple formats." />

                    <nep:NepaliDatePicker
                        DisplayMode="BsOnly"
                        Format="d MMMM yyyy"
                        Placeholder="Pick a date…"
                        SelectedDate="{Binding PickedDate}" />

                    <!--  Result rows  -->
                    <Border Style="{StaticResource ResultCard}">
                        <Border.Background>
                            <AppThemeBinding Dark="#1E1E2E" Light="#F3F0FA" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource ResultLabel}" Text="d MMMM yyyy" />
                            <Label Style="{StaticResource ResultValue}" Text="{Binding Fmt_dMMMMyyy}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ResultCard}">
                        <Border.Background>
                            <AppThemeBinding Dark="#1E1E2E" Light="#F3F0FA" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource ResultLabel}" Text="dd/MM/yyyy" />
                            <Label Style="{StaticResource ResultValue}" Text="{Binding Fmt_ddMMyyy}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ResultCard}">
                        <Border.Background>
                            <AppThemeBinding Dark="#1E1E2E" Light="#F3F0FA" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource ResultLabel}" Text="EEEE, d MMMM yyyy" />
                            <Label Style="{StaticResource ResultValue}" Text="{Binding Fmt_EEEEdMMMMyyy}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ResultCard}">
                        <Border.Background>
                            <AppThemeBinding Dark="#1E1E2E" Light="#F3F0FA" />
                        </Border.Background>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource ResultLabel}" Text="EEE d MMM, yy" />
                            <Label Style="{StaticResource ResultValue}" Text="{Binding Fmt_EEEdMMMyyy}" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Devanagari results  -->
                    <Border
                        Padding="14,10"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#6750A4" />
                                <GradientStop Offset="1" Color="#9C27B0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="10">

                            <Label
                                FontSize="11"
                                Opacity="0.85"
                                Text="Devanagari Script (nepali: true)"
                                TextColor="White" />

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="11"
                                    Opacity="0.75"
                                    Text="d MMMM yyyy"
                                    TextColor="White" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Fmt_dMMMMyyyNp}"
                                    TextColor="White" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="11"
                                    Opacity="0.75"
                                    Text="EEEE, d MMMM yyyy"
                                    TextColor="White" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Fmt_EEEEdMMMMyyyNp}"
                                    TextColor="White" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!--
                ════════════════════════════════════════════════════════════════
                SECTION 2 — MOMENT (RELATIVE TIME)
                ════════════════════════════════════════════════════════════════
            -->
            <Label Style="{StaticResource SectionLabel}" Text="MOMENT — RELATIVE TIME" />

            <Border
                Margin="0,0,0,32"
                Padding="16,14"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Stroke>
                    <AppThemeBinding Dark="#3A3A3A" Light="#E0E0E0" />
                </Border.Stroke>
                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="13"
                        Opacity="0.6"
                        Text="How long ago (or from now) is the picked date, relative to the reference?" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="11" Opacity="0.55" Text="Date" />
                            <nep:NepaliDatePicker
                                DisplayMode="BsOnly"
                                Format="d MMM yyyy"
                                Placeholder="Date…"
                                SelectedDate="{Binding PickedDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label FontSize="11" Opacity="0.55" Text="Reference (blank = today)" />
                            <nep:NepaliDatePicker
                                DisplayMode="BsOnly"
                                Format="d MMM yyyy"
                                Placeholder="Today"
                                SelectedDate="{Binding ReferenceDate}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border
                        Padding="14,12"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#0097A7" />
                                <GradientStop Offset="1" Color="#00695C" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="10">

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="11"
                                    Opacity="0.8"
                                    Text="English"
                                    TextColor="White" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding MomentResult}"
                                    TextColor="White" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="11"
                                    Opacity="0.8"
                                    Text="नेपाली"
                                    TextColor="White" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding MomentResultNepali}"
                                    TextColor="White" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
