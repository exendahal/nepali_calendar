<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NepaliDatePicker</RootNamespace>
    <AssemblyName>NepaliDatePicker.Avalonia</AssemblyName>

    <PackageId>NepaliDatePicker.Avalonia</PackageId>
    <Version>1.0.2</Version>
    <Authors>exendahal</Authors>
    <Copyright>Santosh Dahal</Copyright>
    <Title>Nepali Bikram Sambat (BS) Date Picker for Avalonia</Title>
    <Description>A Nepali Bikram Sambat (BS) date picker control for Avalonia. Supports calendar and wheel styles, BS/AD toggle, Nepali (Devanagari) script, light/dark mode, and full color customization.</Description>
    <PackageTags>avalonia;dotnet;nepali;calendar;bikram-sambat;bs;date-picker;nepal</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/exendahal/nepali_calendar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/exendahal/nepali_calendar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\maui\icon\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\avalonia.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/NepaliUtility.Core.csproj" />
  </ItemGroup>

</Project>
